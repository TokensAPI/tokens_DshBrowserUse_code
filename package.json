{
  "name": "@tokensapi/dsh-browser-use",
  "version": "0.1.1",
  "description": "TokensHarness browser-use plugin: bridges the Playwright MCP server so the model can drive a visible browser",
  "tokenscowork": {
    "displayName": {
      "zh-CN": "浏览器操作",
      "en-US": "Browser Use"
    },
    "summary": {
      "zh-CN": "桥接 Playwright MCP，让模型驱动可见浏览器完成网页操作，带可视光标与坐标模式。",
      "en-US": "Bridge Playwright MCP so the model can drive a visible browser through web tasks, with an on-screen cursor and coordinate mode."
    }
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokensAPI/tokens_DshBrowserUse_code.git"
  },
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./identity.js": "./identity.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "identity.js",
    "cursor-overlay.js",
    "cordis.patch.yml",
    "README.md",
    "locale/*.json"
  ],
  "publishConfig": {
    "registry": "https://npm.tokensapi.ai/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check index.js && node --test",
    "test": "node --test"
  },
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.0.1-rc.1 <=0.1.0-rc.8",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@playwright/mcp": "0.0.79"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "yaml": "^2.9.1"
  }
}
